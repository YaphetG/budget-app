rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // This helper function is no longer needed for collection access,
    // but is kept for the household rule itself.
    function getUserHouseholdId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    // Rules for the 'users' collection.
    match /users/{userId} {
      allow read, create, update: if request.auth.uid == userId;
      allow delete: if false;
    }

    // Rules for the 'households' collection.
    match /households/{householdId} {
      // Read/update is still based on the user's own doc for simplicity here.
      allow read, update: if getUserHouseholdId() == householdId;
      allow create: if request.auth.uid in request.resource.data.members;
      // Allow a user to delete a household ONLY if they are the last member.
      // This prevents orphaning the other user. For now, we'll keep it simple.
      allow delete: if request.auth.uid in resource.data.members;
    }

    // Rules for all collections that are scoped by household.
    match /{collection}/{docId} where collection in ['categories', 'expenses', 'incomes', 'budgets', 'balances'] {

      // **THE FINAL CORRECTED RULE SET**
      // Allow full access if the user is a member of the household the document belongs to.
      // This applies to read, write, update, and delete.
      function isHouseholdMember() {
        let householdId = resource.data.householdId; // For existing docs
        // For create, resource does not exist, so we use request.resource
        if (householdId == null) {
          householdId = request.resource.data.householdId;
        }
        return request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      allow read, write: if isHouseholdMember();
    }
  }
}
