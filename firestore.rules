rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function getUserHouseholdId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    // Rules for the 'users' collection.
    match /users/{userId} {
      allow read, create, update: if request.auth.uid == userId;
      allow delete: if false;
    }

    // Rules for the 'households' collection.
    match /households/{householdId} {
      allow read, update: if getUserHouseholdId() == householdId;
      allow create: if request.auth.uid in request.resource.data.members;
      allow delete: if request.auth.uid in resource.data.members;
    }

    // Rules for all collections that are scoped by household.
    match /{collection}/{docId} where collection in ['categories', 'expenses', 'incomes', 'budgets', 'balances'] {

      // Allow read, update, and delete on existing documents if the user is a member of the household.
      allow read, update, delete:
        if request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members;

      // Allow create on new documents if the user is a member of the household they are assigning the doc to.
      allow create:
        if request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members;
    }
  }
}
