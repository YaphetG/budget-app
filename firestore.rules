rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get the household ID of the currently authenticated user from their user document.
    function getUserHouseholdId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    // Rules for the 'users' collection.
    match /users/{userId} {
      // A user can only read, create, or update their own document. Deletion is disallowed.
      allow read, create, update: if request.auth.uid == userId;
      allow delete: if false;
    }

    // Rules for the 'households' collection.
    match /households/{householdId} {
      // Allow read/update if the user's householdId matches this document's ID.
      allow read, update: if getUserHouseholdId() == householdId;
      // Allow create if the user's UID is in the new household's members list (for sign-up).
      allow create: if request.auth.uid in request.resource.data.members;
      // Disallow deletion of households for now.
      allow delete: if false;
    }

    // Rules for all collections that are scoped by household.
    match /{collection}/{docId} where collection in ['categories', 'expenses', 'incomes', 'budgets', 'balances'] {

      // Allow read, update, and delete operations if the user belongs to the household of the document being accessed.
      // This rule also implicitly secures 'list' (query) operations, as queries from the client
      // MUST include a 'where("householdId", "==", userHouseholdId)' clause to succeed.
      allow read, update, delete: if getUserHouseholdId() == resource.data.householdId;

      // Allow create operations if the user is assigning the new document to their own household.
      allow create: if getUserHouseholdId() == request.resource.data.householdId;
    }
  }
}
